{
  "name": "parkly-smart-parking",
  "version": "2.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "clear": "expo start -c",
    "android": "expo start --android",
    "web": "expo start --web",
    "check": "npx expo-doctor@latest",
    "eas:configure": "npx eas-cli@latest build:configure",
    "eas:credentials": "npx eas-cli@latest credentials -p android",
    "build:apk": "npx eas-cli@latest build -p android --profile preview",
    "build:aab": "npx eas-cli@latest build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
